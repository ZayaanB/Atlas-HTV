# Server-only. Use backend/.env; scripts do not load .env.local.
# Setup: backend/docs/credentials-setup.md. Never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Deadline for the whole request lifecycle, including response processing.
REQUEST_TIMEOUT_MS=30000
# Relative to repository root. Build contracts before starting the backend.
# The merged authoritative registry currently covers news/locations only.
ATLAS_CONTRACTS_MODULE=contracts/dist/index.js
ATLAS_DATABASE_MODULE=db/handoff/database.mjs
ATLAS_SOURCES_MODULE=scripts/source-definitions/atlas.mjs
# TLS always verifies the server certificate. Do not add sslmode overrides.
# Uncomment and replace with the existing team service's actual connection URL.
# DATABASE_URL='postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE'
# DATABASE_CA_FILE=/absolute/path/to/trusted-ca.pem
# Both must be set together; choose a model available in your account.
# GEMINI_API_KEY='PASTE_YOUR_KEY_HERE'
# GEMINI_MODEL='PASTE_AVAILABLE_MODEL_ID_HERE'
# Optional semantic retrieval; indexing and queries must use the same identity.
# EMBEDDING_MODEL=
# EMBEDDING_VERSION=
# EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_TOOL_CALLS=8
AI_MAX_ROUNDS=4
AI_MAX_CONTEXT_BYTES=64000
AI_MAX_CONCURRENT=2
RATE_LIMIT_MAX=120
PROVIDER_TIMEOUT_MS=8000
# Enable only after source/attribution/polling review and regions handoff.
FLIGHTS_ENABLED=false
FLIGHTS_REFRESH_INTERVAL_MS=60000
FLIGHTS_STALE_AFTER_MS=120000
FLIGHTS_CACHE_TTL_MS=300000
FLIGHTS_MAX_ACTIVE_REGIONS=3
# No news timer is enabled. Refresh is an explicit CLI operation.
# No frontend/public/VITE credentials belong here.
