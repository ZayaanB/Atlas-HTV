# Server-only. Use backend/.env; scripts do not load .env.local.
# Setup: backend/docs/credentials-setup.md. Never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Deadline for the whole request lifecycle, including response processing.
REQUEST_TIMEOUT_MS=60000
# Relative to repository root. Build contracts before starting the backend.
# The authoritative registry includes assistant, investigation and timeline schemas.
ATLAS_CONTRACTS_MODULE=contracts/dist/index.js
ATLAS_DATABASE_MODULE=db/handoff/database.mjs
ATLAS_SOURCES_MODULE=scripts/source-definitions/atlas.mjs
# TLS always verifies the server certificate. Do not add sslmode overrides.
# Uncomment and replace with the existing team service's actual connection URL.
# DATABASE_URL='postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE'
# DATABASE_CA_FILE=/absolute/path/to/trusted-ca.pem
# Both must be set together; choose a model available in your account.
# GEMINI_API_KEY='PASTE_YOUR_KEY_HERE'
# GEMINI_MODEL='PASTE_AVAILABLE_MODEL_ID_HERE'
# For a Gemini model supporting thinking levels (e.g. Gemini 3); omit otherwise.
# GEMINI_THINKING_LEVEL=low
# Optional semantic retrieval; indexing and queries must use the same identity.
# EMBEDDING_MODEL=
# EMBEDDING_VERSION=
# EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=50000
AI_MAX_TOOL_CALLS=8
AI_MAX_ROUNDS=6
# Rich investigation + original source metadata + tool definitions; hard cap 128 KB.
AI_MAX_CONTEXT_BYTES=128000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_CONCURRENT=2
RATE_LIMIT_MAX=120
PROVIDER_TIMEOUT_MS=8000
# Manual news imports can be slower; their whole operation still has a 60 s deadline.
INGESTION_PROVIDER_TIMEOUT_MS=30000
# Enable only after source/attribution/polling review. Area queries additionally
# require Person 1's FlightAreaQuery/FlightAreaResponse shared schema handoff.
FLIGHTS_ENABLED=false
# Wind API is on demand only; the browser toggle defaults OFF. Free Open-Meteo is
# for non-commercial use. Set false to disable all wind provider access.
WIND_ENABLED=true
# Default remains adsb.lol; choose airlabs for the shared global airline snapshot.
FLIGHTS_PROVIDER=adsb.lol
# AIRLABS_API_KEY=YOUR_FREE_AIRLABS_KEY
# Optional absolute persistent directory. Default: backend/.flight-budget/
# FLIGHTS_BUDGET_DIRECTORY=/YOUR_PERSISTENT_PRIVATE_PATH/flight-budget
# AirLabs: five-minute demand-driven refresh; hard 900-attempt demo cap, no reset.
# Global capability stays disabled until Person 1 supplies FlightGlobalResponse.
# Required when enabled: real contact email or HTTPS project/contact URL. Sent
# to ADSB.lol in the User-Agent; keep your actual contact in private backend/.env.
# FLIGHTS_CONTACT=https://YOUR_PROJECT_DOMAIN/contact
FLIGHTS_REFRESH_INTERVAL_MS=60000
FLIGHTS_STALE_AFTER_MS=120000
FLIGHTS_CACHE_TTL_MS=300000
FLIGHTS_MAX_ACTIVE_REGIONS=2
# Shared by configured regions and map areas, including failed requests.
FLIGHTS_GLOBAL_INTERVAL_MS=30000
# An unused area can be evicted after two minutes to admit another viewer.
FLIGHTS_AREA_IDLE_MS=120000
# No in-process timer: the API never polls news/observation providers. Refresh with `npm run ingest -- --all`
# (scheduled on the VM by infra/atlas-ingest.timer; see docs/live-ingestion.md).
# No frontend/public/VITE credentials belong here.
