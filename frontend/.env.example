# Default: real API through same-origin /api (Vite proxies to 127.0.0.1:3001).
VITE_DATA_MODE=api
# Use VITE_DATA_MODE=fixture for visibly labeled historical examples, or npm run dev:fixture.
# Geographic rendering requires VITE_MAPBOX_ACCESS_TOKEN, a restricted public token.
# Without it the globe is unavailable; news and historical research remain usable.
# Never add GEMINI_API_KEY or DATABASE_URL to browser configuration.
