# Deployment environment NAMES only (Person 4 with Person 3). Every name is commented: the backend rejects blank
# values, so uncomment a line only when you set it. No values are committed: no domain, IP, keys,
# passwords or connection strings. On the VM, fill these in root-owned files outside Git:
#   /etc/atlas/backend.env  (owner root, group atlas, mode 0640) -> read by atlas-backend.service
#   /etc/atlas/caddy.env    (owner root, group caddy, mode 0640) -> read by the caddy.service drop-in
# Backend names and semantics are defined by backend/src/config.ts and backend/.env.example (Person 3).

# ---- /etc/atlas/backend.env -------------------------------------------------------------------------------
# Runtime (required for deployment). Use NODE_ENV=production, HOST=127.0.0.1 (loopback behind Caddy),
# PORT=3001 (must match infra/Caddyfile reverse_proxy).
# NODE_ENV=
# HOST=
# PORT=
# Repository-relative integration modules (resolved against /opt/atlas).
# ATLAS_CONTRACTS_MODULE=
# ATLAS_DATABASE_MODULE=
# ATLAS_SOURCES_MODULE=
# SECRET: Tiger Cloud connection URL for the least-privilege runtime role (not the admin role), without sslmode.
# DATABASE_URL=
# Optional: absolute path to a trusted CA bundle if the system store does not verify the Tiger Cloud certificate.
# DATABASE_CA_FILE=
# SECRET: Gemini API key; set together with GEMINI_MODEL.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional semantic retrieval; must match the identity registered in atlas.embedding_models.
# EMBEDDING_MODEL=
# EMBEDDING_VERSION=
# EMBEDDING_DIMENSIONS=
# Optional limits (backend defaults apply when unset).
# REQUEST_TIMEOUT_MS=
# AI_REQUEST_TIMEOUT_MS=
# AI_MAX_TOOL_CALLS=
# AI_MAX_ROUNDS=
# AI_MAX_CONTEXT_BYTES=
# AI_MAX_CONCURRENT=
# RATE_LIMIT_MAX=
# PROVIDER_TIMEOUT_MS=
# Flights stay false until the ADSB.lol production-use contact is recorded (scripts/source-definitions/README.md).
# FLIGHTS_ENABLED=
# FLIGHTS_REFRESH_INTERVAL_MS=
# FLIGHTS_STALE_AFTER_MS=
# FLIGHTS_CACHE_TTL_MS=
# FLIGHTS_MAX_ACTIVE_REGIONS=

# ---- /etc/atlas/caddy.env ---------------------------------------------------------------------------------
# The eligible GoDaddy Registry domain once registered and resolving (e.g. the apex name only, no scheme).
# ATLAS_DOMAIN=

# ---- Build-time only (Person 1, frontend; not a server secret) ---------------------------------------------
# VITE_MAPBOX_ACCESS_TOKEN: restricted public token (URL-restricted to the deployed domain), set at build time.
